# ==============================================================================
# CSL Skill Matrix & Assessment System — Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
# In local development: leave empty to leverage Vite proxy at /api -> http://127.0.0.1:8000
# In Vercel production: set to your deployed Render service URL (e.g., https://csl-backend.onrender.com)
VITE_API_BASE_URL=https://csl-backend.onrender.com

# Main CSL Website URL
# Redirect destination for candidates after completing the initial assessment
VITE_CSL_MAIN_WEBSITE_URL=https://csl.example.com
