# ==============================================================================
# CSL Skill Matrix & Assessment System — Backend Environment Configuration
# ==============================================================================

# Core Django Settings
# In production on Render, set DJANGO_DEBUG=False
DJANGO_DEBUG=False

# Generate a strong, random 50+ character secret key. NEVER commit the real secret.
# Example: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-secure-50-character-secret-key-in-production

# Hostnames allowed to serve requests (comma-separated, no spaces)
# Example: csl-backend.onrender.com,localhost
DJANGO_ALLOWED_HOSTS=csl-backend.onrender.com

# PostgreSQL / Neon Database Connection
# Complete Neon PostgreSQL connection string (pooled or unpooled with sslmode=require)
# Example: postgresql://username:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/csl_db?sslmode=require
DATABASE_URL=postgresql://user:password@ep-name.region.aws.neon.tech/neondb?sslmode=require

# PostgreSQL Connection Pooling Max Age (seconds)
# Set to 60 for web services, or 0 if Neon PgBouncer handles connection recycling
DATABASE_CONN_MAX_AGE=60

# Production Security & HTTPS Settings
# Set to True on Render/production behind HTTPS reverse proxy
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# CORS & CSRF Trusted Origins (frontend URLs allowed to communicate with this backend)
# Example: https://csl-assessment.vercel.app,http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=https://csl-assessment.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://csl-assessment.vercel.app

# Logging level (INFO, WARNING, ERROR, DEBUG)
DJANGO_LOG_LEVEL=INFO
